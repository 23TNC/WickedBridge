# Compiled Python -- regenerated by the build from source/
# The game needs .pyc compiled by Python 3.7, but they are build output, not source.
__pycache__/
*.pyc
*.pyo
*.pyd

# Local build scratch
build/
dist/
*.egg-info/

# Diagnostic output written by the mod at runtime
WickedBridge_status.txt
WickedBridge_hello.txt

# The Sims 4 writes these next to the mod during testing
lastException*.txt
lastUIException*.txt
WickedWhimsInfoLog.log
WickedWhims_*_Exception.txt

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
